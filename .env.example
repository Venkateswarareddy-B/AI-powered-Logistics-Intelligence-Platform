# ============================================================
# YottaFlex - AI-Powered Logistics Intelligence Platform
# Environment Variables
# ------------------------------------------------------------
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file.
# NEVER put production secrets here.
# All values below are PLACEHOLDERS / safe local defaults only.
# ============================================================

# ---------- Application ----------
APP_NAME=YottaFlex
APP_TAGLINE=AI-Powered Logistics Intelligence Platform
# local | demo | production
ENV=local
DEBUG=true
API_V1_PREFIX=/api
LOG_LEVEL=INFO

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS_STR=http://localhost:5173,http://localhost:4173,http://localhost:3000

# ---------- PostgreSQL ----------
# Platform Postgres runs on host port 5434 to avoid conflict with
# any native PostgreSQL installation on the default 5432.
# Docker Compose: docker compose up -d  (see docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=logistics
POSTGRES_PASSWORD=logistics
POSTGRES_DB=logistics_ai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

# Docker Compose image override (defaults to postgres:16, locally cached)
POSTGRES_VERSION=16
# Host port binding for Docker Compose (change only if 5434 is also taken)
POSTGRES_HOST_PORT=5434

# ---------- JWT / Auth ----------
# Generate a strong random value for production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-this-is-not-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Demo login ----------
# Demo-only credentials shown in the README. NOT for production.
DEMO_USER_ENABLED=true
DEMO_USERNAME=demo_admin
DEMO_PASSWORD=Demo@YottaFlex2026
DEMO_USER_FULL_NAME=Demo Administrator
DEMO_USER_ROLE=ADMIN

# ---------- Groq / GenAI ----------
# OpenAI is intentionally NOT used. Get a key at https://console.groq.com/keys
# The application runs in demo mode without this key; GenAI features will show
# a clear configuration message instead of crashing.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_REQUEST_TIMEOUT_SECONDS=60
# Set to true only after a valid GROQ_API_KEY is provided
GROQ_ENABLED=false

# ---------- RAG ----------
# Local embedding model — no OpenAI embeddings used
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
CHROMA_PERSIST_DIR=./data/chroma
# Set to true after ChromaDB + embeddings are initialized (Phase 17)
RAG_ENABLED=false

# ---------- Machine Learning ----------
ML_MODELS_DIR=./ml/models
ML_ARTIFACTS_DIR=./ml/artifacts
ML_DEFAULT_ETA_MODEL=eta_gradient_boosting
ML_DEFAULT_DELAY_MODEL=delay_gradient_boosting
RANDOM_SEED=20261022

# ---------- Demo data ----------
DEMO_DATA_SEED=20261022
DEMO_DEFAULT_SHIPMENTS=100
DEMO_DATA_DIR=./data/demo
